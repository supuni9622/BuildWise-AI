# =============================================================================
# BuildWise AI
# Local development environment
#
# IMPORTANT:
# - Do not commit this file.
# - Store real API keys only in this local file or a secret manager.
# - Keep .env.example in Git with empty credentials.
# =============================================================================


# =============================================================================
# Application
# =============================================================================

APP_NAME=BuildWise AI
APP_VERSION=0.1.0

# Supported values:
# local
# test
# docker
# staging
# production
APP_ENV=local

DEBUG=true
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1


# =============================================================================
# Database
# =============================================================================

# Local application execution outside Docker.
# Keep this port aligned with POSTGRES_PORT below:
DATABASE_URL=postgresql+psycopg://buildwise:buildwise@localhost:5432/buildwise

# The application container receives this internal Docker-network URL
# automatically from docker-compose.yml:
# postgresql+psycopg://buildwise:buildwise@postgres:5432/buildwise


# =============================================================================
# PostgreSQL
# =============================================================================

POSTGRES_DB=buildwise
POSTGRES_USER=buildwise
POSTGRES_PASSWORD=buildwise

# Change this for staging and production.
POSTGRES_PORT=5432


# =============================================================================
# Provider API credentials
# =============================================================================

# Primary BuildWise runtime provider.
OPENAI_API_KEY=

# Reserved for Claude evaluation and optional cross-provider experiments.
ANTHROPIC_API_KEY=


# =============================================================================
# Active BuildWise workflow models
#
# These models execute the normal production workflow.
#
# Provider/model format:
# openai/<model-id>
# anthropic/<model-id>
# =============================================================================

# Low-cost and low-latency operations:
# - completeness classification
# - capability classification
# - clarification assistance
# - bounded output repair
# - lightweight semantic checks
FAST_MODEL=openai/gpt-5-mini

# General specialist agents:
# - Discovery Analyst
# - Product Manager
# - Business Analyst
# - Market and GTM Strategist
# - Security Architect
# - QA and Evaluation Architect
PRIMARY_AGENT_MODEL=openai/gpt-5-mini

# High-reasoning architecture work:
# - Solution Architect
# - AI Architect
ARCHITECT_MODEL=openai/gpt-5.2

# Final cross-specialist review:
# - consistency checking
# - contradiction detection
# - missing coverage
# - bounded revision decisions
# - final blueprint approval
LEAD_REVIEWER_MODEL=openai/gpt-5.2


# =============================================================================
# OpenAI compatibility fallback models
#
# These are conservative fallback choices from the GPT-4.1 model family.
#
# IMPORTANT:
# Defining these variables does not automatically activate fallback behavior.
# The application must explicitly catch eligible provider/model failures and
# retry using the appropriate fallback model.
# =============================================================================

FALLBACK_FAST_MODEL=openai/gpt-4.1-nano
FALLBACK_PRIMARY_MODEL=openai/gpt-4.1-mini
FALLBACK_ARCHITECT_MODEL=openai/gpt-4.1
FALLBACK_LEAD_REVIEWER_MODEL=openai/gpt-4.1


# =============================================================================
# Fallback controls
# =============================================================================

# Keep disabled until the fallback policy, logging, usage accounting, and
# validation have been implemented.
MODEL_FALLBACK_ENABLED=false

# Maximum number of fallback model attempts after the primary model fails.
MODEL_FALLBACK_MAX_ATTEMPTS=1

# Do not use fallbacks for invalid requests, schema bugs, authentication
# failures, or safety-policy failures.
#
# Intended future eligible categories:
# - provider_timeout
# - transient_provider_error
# - model_unavailable
# - unsupported_model_parameter
MODEL_FALLBACK_ON_TIMEOUT=true
MODEL_FALLBACK_ON_RATE_LIMIT=false
MODEL_FALLBACK_ON_MODEL_UNAVAILABLE=true


# =============================================================================
# CrewAI runtime
# =============================================================================

# Enables CrewAI's native Flow/Crew execution traces. This is passed explicitly
# to every BuildWise Flow and Crew, so it overrides per-user CLI trace consent.
CREWAI_TRACING_ENABLED=true
CREWAI_VERBOSE=true


# =============================================================================
# Anthropic evaluation models
#
# Claude does not execute the normal BuildWise workflow by default.
# It is used later for:
# - LLM-as-judge evaluation
# - cross-provider quality comparison
# - reviewer experiments
# - benchmark analysis
# =============================================================================

# Cost-conscious evaluator for routine benchmark scoring.
EVALUATION_MODEL=anthropic/claude-sonnet-5

# Strong evaluator for final benchmark adjudication or difficult comparisons.
STRONG_EVALUATION_MODEL=anthropic/claude-opus-4-8

# Optional Claude model mapping for full cross-provider workflow experiments.
CLAUDE_FAST_MODEL=anthropic/claude-haiku-4-5
CLAUDE_PRIMARY_MODEL=anthropic/claude-sonnet-5
CLAUDE_ARCHITECT_MODEL=anthropic/claude-sonnet-5
CLAUDE_LEAD_REVIEWER_MODEL=anthropic/claude-opus-4-8


# =============================================================================
# Evaluation controls
# =============================================================================

# Enables Claude evaluation of completed OpenAI-generated artifacts.
EVALUATION_ENABLED=false

# Runs the same selected BuildWise scenario through both providers.
# Keep disabled for normal user requests because it substantially increases
# token usage and cost.
CROSS_PROVIDER_EVALUATION_ENABLED=false

# Fraction of completed consultations selected for evaluation.
#
# 0.0 = none
# 0.1 = 10 percent
# 1.0 = all
EVALUATION_SAMPLE_RATE=0.0

# Persist evaluation inputs, scores, feedback, model metadata, token usage,
# latency, and estimated cost.
STORE_EVALUATION_OUTPUTS=true

# A Claude evaluation failure must not fail the main BuildWise consultation.
EVALUATION_BEST_EFFORT=true

# Run evaluations asynchronously after the main workflow has completed.
EVALUATION_ASYNC=true


# =============================================================================
# CrewAI
# =============================================================================

CREWAI_TRACING_ENABLED=true
CREWAI_VERBOSE=true


# =============================================================================
# LLM runtime controls
# =============================================================================

LLM_MAX_RETRIES=2
LLM_REQUEST_TIMEOUT_SECONDS=120

MAX_AGENT_ITERATIONS=12
MAX_EXECUTION_SECONDS=900


# =============================================================================
# Usage and cost controls
# =============================================================================

MAX_SESSION_TOKENS=120000
MAX_ESTIMATED_COST_USD=10.00

MAX_AGENT_EXECUTIONS=20
MAX_TOOL_CALLS=30
MAX_RETRIES_PER_OPERATION=2


# =============================================================================
# Logging and observability
# =============================================================================

ENABLE_STRUCTURED_LOGGING=true
LOG_REQUEST_BODIES=false
LOG_LLM_PROMPTS=false
LOG_LLM_RESPONSES=false

ENABLE_USAGE_TRACKING=true
ENABLE_COST_TRACKING=true
ENABLE_MODEL_LATENCY_TRACKING=true


# =============================================================================
# Development-only CORS
# =============================================================================

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DEBUG=false

SERPER_API_KEY=
